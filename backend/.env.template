# LogicShield Backend Environment Variables Template
# Copy this file to .env and fill in your values

# ===================
# Database Configuration
# ===================

# Database connection URL
DATABASE_URL="sqlite:///./logicshield.db"

# Set to "false" to use PostgreSQL instead of SQLite
USE_SQLITE="true"

# On vercel deployments, via prisma
VERCEL_DB_PRISMA_DATABASE_URL="postgres://5c702500cc943c"
VERCEL_DB_PRISMA_POSTGRES_URL="postgres://5c702500cc943c"
VERCEL_DB_PRISMA_DATABASE_URL="postgres://5c702500cc943c"

# ===================
# Security
# ===================

# Secret key for JWT tokens and sessions
# IMPORTANT: Change this in production!
SECRET_KEY="logic-shield-secret-key-change-in-production"

# ===================
# Hugging Face Configuration
# ===================

# Hugging Face token for faster downloads and higher rate limits
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=""

# Use a mirror for model downloads (useful in regions with limited access)
HF_ENDPOINT=""

# ===================
# Application Settings
# ===================

# Server host
HOST="0.0.0.0"

# Server port
PORT="8000"

# Debug mode (set to "false" in production)
DEBUG="true"

# ===================
# CORS Configuration
# ===================

# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ===================
# ML Model Configuration
# ===================

# Fallacy detection model
FALLACY_MODEL="facebook/bart-large-mnli"

# Sentence embedding model for coherence scoring
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# ===================
# Logging
# ===================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
